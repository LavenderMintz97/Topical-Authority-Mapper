# GEMINI_API_KEY: Required for Gemini AI API calls.
# ⚠️ MUST start with VITE_ for Vite to expose it to frontend
# Replace with your actual key in .env (NOT committed to GitHub)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted
VITE_APP_URL=https://lavendermintz97.github.io/Topical-Authority-Mapper/